# Docker Compose demo configuration. Copy to .env and choose local passwords.
POSTGRES_PASSWORD=change-this-local-database-password
DJANGO_SECRET_KEY=replace-with-a-random-key-before-deployment
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8083,http://127.0.0.1:8083
CORS_ALLOWED_ORIGINS=http://localhost:8083,http://127.0.0.1:8083
SEED_DEMO=true
# Production: false debug, false seeding, HTTPS, and new user credentials.
# DATABASE_URL=postgresql://glassdesk:password@localhost:5432/glassdesk

# Optional deployment settings for compose.production.yaml:
# PUBLIC_HOSTNAME=support.example.com
# TLS_CERT_FILE=/etc/letsencrypt/live/support.example.com/fullchain.pem
# TLS_KEY_FILE=/etc/letsencrypt/live/support.example.com/privkey.pem
# API_USER_RATE=300/minute
